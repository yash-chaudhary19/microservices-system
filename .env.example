# System Environment Configuration Template

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
USERS_DB=users_db
NOTIFICATIONS_DB=notifications_db

# Database URLs for Services
USER_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/users_db
NOTIFICATION_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/notifications_db

# NATS Configuration
NATS_HOST=nats
NATS_PORT=4222
NATS_URL=nats://nats:4222
NATS_USER=app_user
NATS_PASSWORD=nats_secure_password

# API Gateway & Security
GATEWAY_PORT=8000
JWT_SECRET=production-grade-random-secret-key-change-me-in-prod-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Service Ports
USER_SERVICE_PORT=8001
NOTIFICATION_SERVICE_PORT=8002
